# Copy to .env and fill in. Never commit .env.
# LLM (default: Google Gemini free tier - key from https://aistudio.google.com)
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite; `npm run check-llm` lists available models)
# LLM_MODEL=gemini-3.5-flash-lite
# Alternative provider: set OPENAI_API_KEY and leave GEMINI_API_KEY empty
# OPENAI_API_KEY=
# All REST calls of the agent go through the API Gateway
GATEWAY_URL=http://localhost:8000
# MCP over Streamable HTTP (docker compose). Remove to start the MCP server locally over stdio.
MCP_URL=http://localhost:3001/mcp
# Must match the jwt_secrets.secret in gateway/kong.yml
JWT_SECRET=dev-only-jwt-secret-change-me
